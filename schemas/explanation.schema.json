{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-roadmaps.dev/schemas/explanation.schema.json",
  "title": "Paper explanation contribution",
  "type": "object",
  "required": ["id", "paperId", "title", "url"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "paperId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 2 },
    "url": { "type": "string", "format": "uri" }
  },
  "additionalProperties": false
}
