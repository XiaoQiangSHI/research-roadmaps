{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-roadmaps.dev/schemas/roadmap.schema.json",
  "title": "Research roadmap",
  "type": "object",
  "required": ["id", "name", "description", "kind"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 2 },
    "description": { "type": "string", "minLength": 10 },
    "kind": { "enum": ["full", "view"] },
    "category": { "enum": ["task-domain", "method-system", "cross-cutting"] },
    "scope": {
      "type": "object",
      "required": ["include", "exclude", "relatedDomains"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 4 }
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 4 }
        },
        "relatedDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      },
      "additionalProperties": false
    },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "source": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "includeTracks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    },
    "editorial": {
      "type": "object",
      "properties": {
        "note": { "type": "string" },
        "maintainers": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "full" } } },
      "then": { "required": ["category", "scope", "period", "tracks"] }
    },
    {
      "if": { "properties": { "kind": { "const": "view" } } },
      "then": { "required": ["source", "includeTracks"] }
    }
  ],
  "$defs": {
    "track": {
      "type": "object",
      "required": ["id", "index", "name", "color", "problem", "evolution"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "index": { "type": "string", "pattern": "^[0-9]{2}$" },
        "name": { "type": "string", "minLength": 2 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "problem": { "type": "string", "minLength": 10 },
        "evolution": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "label": { "type": "string", "minLength": 2 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
