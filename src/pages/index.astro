---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listRoadmaps } from '@/lib/data';

const roadmaps = await listRoadmaps();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Open Research Roadmaps" description="开放、可审查、数据驱动的研究发展路线图库。">
  <main class="shell">
    <section class="roadmap-grid" aria-label="路线图列表">
      {roadmaps.map((roadmap) => (
        <a class="roadmap-card" href={`${base}roadmaps/${roadmap.id}/`}>
          <span>{roadmap.kind === 'view' ? '专题视图' : '完整领域'}</span>
          <h2>{roadmap.name}</h2>
          <p>{roadmap.description}</p>
          <dl>
            <div><dt>论文</dt><dd>{roadmap.papers.length}</dd></div>
            <div><dt>线路</dt><dd>{roadmap.tracks.length}</dd></div>
            <div><dt>时期</dt><dd>{roadmap.period.start.slice(0, 4)}—{roadmap.period.end.slice(0, 4)}</dd></div>
          </dl>
        </a>
      ))}
      <a class="roadmap-card contribute" href={`${base}about/`}>
        <span>CONTRIBUTE</span>
        <h2>贡献一个新领域</h2>
        <p>复制数据模板、补充来源并提交 Pull Request，页面会自动生成。</p>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .roadmap-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; padding: 48px 0 80px; }
  .roadmap-card { padding: 28px; border: 1px solid var(--line); border-radius: 18px; background: color-mix(in srgb, var(--surface) 78%, transparent); color: inherit; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease; }
  .roadmap-card:hover { transform: translateY(-3px); box-shadow: 0 16px 36px rgba(31, 39, 35, .09); }
  .roadmap-card > span { color: var(--accent); font-size: 11px; font-weight: 800; letter-spacing: .12em; }
  h2 { margin: 12px 0 0; font-family: Georgia, "Songti SC", serif; font-size: 30px; font-weight: 500; }
  .roadmap-card > p { min-height: 54px; margin: 12px 0 0; color: var(--muted); line-height: 1.65; }
  dl { display: flex; gap: 26px; margin: 24px 0 0; }
  dl div { display: flex; gap: 6px; }
  dt { color: var(--muted); }
  dd { margin: 0; font-weight: 800; }
  .contribute { border-style: dashed; }
  @media (max-width: 760px) { .roadmap-grid { grid-template-columns: 1fr; padding-top: 32px; } }
</style>
