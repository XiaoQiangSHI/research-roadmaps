---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RoadmapTimeline from '@/components/RoadmapTimeline.astro';
import { listRoadmapIds, loadRoadmap } from '@/lib/data';

export async function getStaticPaths() {
  return Promise.all((await listRoadmapIds()).map(async (id) => ({ params: { id }, props: { roadmap: await loadRoadmap(id) } })));
}

const { roadmap } = Astro.props;
const base = import.meta.env.BASE_URL;
const usedInstitutionIds = new Set(roadmap.papers.flatMap((paper) => [...paper.institutions.primary, ...(paper.institutions.collaborators || [])]));
const categoryLabels = { 'task-domain': '任务与研究对象', 'method-system': '方法与系统', 'cross-cutting': '横向与应用领域' };
const roadmaps = await Promise.all((roadmap.scope?.relatedDomains || []).map(loadRoadmap));
---

<BaseLayout title={`${roadmap.name} · Open Research Roadmaps`} description={roadmap.description}>
  <header class="hero shell">
    <p>{roadmap.category ? categoryLabels[roadmap.category] : '专题视图'} · {roadmap.period.start.slice(0, 4)}—{roadmap.period.end.slice(0, 4)}</p>
    <h1>{roadmap.name}</h1>
    <div>{roadmap.description}</div>
    <a class="contribute-button" href={`${base}contribute/?domain=${roadmap.id}`}>贡献论文 <span aria-hidden="true">↗</span></a>
    <dl>
      <div><dt>论文 / 技术文章</dt><dd>{roadmap.papers.length}</dd></div>
      <div><dt>发展线路</dt><dd>{roadmap.tracks.length}</dd></div>
      <div><dt>论文机构</dt><dd>{usedInstitutionIds.size}</dd></div>
    </dl>
  </header>
  <main class="shell">
    {roadmap.papers.length === 0 && (
      <section class="empty-state">
        <span>WAITING FOR FIRST PAPER</span>
        <h2>路线骨架已经建立，等待第一篇论文</h2>
        <p>下面的线路用于启动社区讨论，并非已经定稿。你可以贡献代表论文，也可以在 Pull Request 中建议调整问题定义和演进阶段。</p>
        <a href={`${base}contribute/?domain=${roadmap.id}`}>贡献第一篇论文</a>
      </section>
    )}
    {roadmap.scope && (
      <section class="scope-card" aria-labelledby="scope-title">
        <header><span>DOMAIN BOUNDARY</span><h2 id="scope-title">这个领域收录什么</h2><p>领域之间允许交叉，但每篇论文应按核心问题选择一个主领域，避免重复维护事实。</p></header>
        <div class="scope-columns">
          <section><h3>收录</h3><ul>{roadmap.scope.include.map((item) => <li>{item}</li>)}</ul></section>
          <section><h3>不收录</h3><ul>{roadmap.scope.exclude.map((item) => <li>{item}</li>)}</ul></section>
        </div>
        {roadmaps.length > 0 && <nav aria-label="相邻领域"><span>相邻领域</span>{roadmaps.map((related) => <a href={`${base}roadmaps/${related.id}/`}>{related.name}</a>)}</nav>}
      </section>
    )}
    <RoadmapTimeline roadmap={roadmap} />
  </main>
  <footer class="shell">
    {roadmap.editorial?.note || '路线归属用于解释技术演进，不代表唯一学术分类。'} 数据、机构与归类依据均可通过 Pull Request 审查和修订。
  </footer>
</BaseLayout>

<style>
  .hero { padding: 70px 0 24px; }
  .hero > p { margin: 0 0 12px; color: var(--accent); font-size: 13px; font-weight: 800; letter-spacing: .12em; }
  h1 { max-width: 1050px; margin: 0; font-family: Georgia, "Songti SC", serif; font-size: clamp(42px, 6vw, 76px); font-weight: 500; line-height: 1.05; letter-spacing: -.035em; }
  .hero > div { max-width: 880px; margin-top: 20px; color: var(--muted); font-size: 17px; line-height: 1.8; }
  .contribute-button { display: inline-flex; gap: 28px; align-items: center; margin-top: 22px; padding: 12px 15px; border-radius: 10px; background: var(--accent); color: var(--surface); font-size: 13px; font-weight: 800; text-decoration: none; }
  dl { display: flex; gap: 12px; margin: 30px 0 0; }
  dl div { min-width: 180px; padding: 17px 19px; border: 1px solid var(--line); border-radius: 13px; background: color-mix(in srgb, var(--surface) 72%, transparent); }
  dt { color: var(--muted); font-size: 12px; }
  dd { margin: 5px 0 0; font-family: Georgia, serif; font-size: 28px; }
  footer { margin-top: 28px; padding: 24px 0 50px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; line-height: 1.7; }
  .empty-state { display: grid; justify-items: start; margin: 12px 0 24px; padding: 28px; border: 1px dashed var(--line-strong); border-radius: 18px; background: color-mix(in srgb, var(--surface) 72%, transparent); }
  .empty-state > span { color: var(--accent); font-size: 10px; font-weight: 800; letter-spacing: .12em; }
  .empty-state h2 { margin: 10px 0 0; font-family: Georgia, "Songti SC", serif; font-size: 28px; font-weight: 500; }
  .empty-state p { max-width: 800px; margin: 10px 0 0; color: var(--muted); line-height: 1.7; }
  .empty-state a { margin-top: 16px; color: var(--accent); font-size: 13px; font-weight: 800; }
  .scope-card { margin: 12px 0 24px; padding: 27px; border: 1px solid var(--line); border-radius: 18px; background: color-mix(in srgb, var(--surface) 82%, transparent); }
  .scope-card > header > span { color: var(--accent); font-size: 10px; font-weight: 800; letter-spacing: .12em; }
  .scope-card > header h2 { margin: 8px 0 0; font-family: Georgia, "Songti SC", serif; font-size: 28px; font-weight: 500; }
  .scope-card > header p { margin: 8px 0 0; color: var(--muted); font-size: 12px; line-height: 1.65; }
  .scope-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 20px; }
  .scope-columns section { padding: 17px; border: 1px solid var(--line); border-radius: 13px; background: color-mix(in srgb, var(--bg) 42%, var(--surface)); }
  .scope-columns h3 { margin: 0; font-size: 12px; }
  .scope-columns ul { display: grid; gap: 8px; margin: 10px 0 0; padding-left: 18px; color: var(--muted); font-size: 12px; line-height: 1.65; }
  .scope-card nav { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 16px; }
  .scope-card nav span { margin-right: 3px; color: var(--muted); font-size: 11px; }
  .scope-card nav a { padding: 6px 9px; border: 1px solid var(--line); border-radius: 999px; color: var(--accent); font-size: 10px; text-decoration: none; }
  @media (max-width: 620px) { .hero { padding-top: 48px; } dl { display: grid; grid-template-columns: repeat(3, 1fr); } dl div { min-width: 0; padding: 13px; } dd { font-size: 22px; } .scope-card { padding: 22px 17px; } .scope-columns { grid-template-columns: 1fr; } }
</style>
