---
import type { Institution } from '@/lib/data';
import { brandPaths } from '@/lib/brand-icons';

interface Props {
  institution?: Institution;
  size?: 'small' | 'large';
}

const { institution, size = 'small' } = Astro.props;
const brandPath = institution?.logo.kind === 'brand' ? brandPaths[institution.logo.value] : undefined;
const label = institution?.shortName || 'Research team';
---

<span class:list={['org-mark', { large: size === 'large' }]} aria-label={label}>
  {brandPath ? (
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={brandPath}></path></svg>
  ) : (
    <span aria-hidden="true">{institution?.logo.value || 'R'}</span>
  )}
</span>

<style>
  .org-mark {
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid color-mix(in srgb, var(--route, var(--accent)) 35%, var(--line));
    border-radius: 7px;
    background: color-mix(in srgb, var(--route, var(--accent)) 9%, var(--surface));
    color: color-mix(in srgb, var(--route, var(--accent)) 82%, var(--ink));
    font-size: 8px;
    font-weight: 800;
    letter-spacing: -.03em;
  }
  .org-mark.large { width: 38px; height: 38px; border-radius: 10px; font-size: 10px; }
  svg { width: 16px; height: 16px; fill: currentColor; }
  .large svg { width: 24px; height: 24px; }
</style>
