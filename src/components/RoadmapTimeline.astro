---
import InstitutionMark from './InstitutionMark.astro';
import type { ResolvedRoadmap } from '@/lib/data';
import { brandPaths } from '@/lib/brand-icons';

interface Props { roadmap: ResolvedRoadmap }
const { roadmap } = Astro.props;
const institutionMap = new Map(roadmap.institutions.map((institution) => [institution.id, institution]));
const start = Date.parse(`${roadmap.period.start}T00:00:00Z`);
const end = Date.parse(`${roadmap.period.end}T00:00:00Z`);
const dateX = (date: string) => Math.max(0, Math.min(100, ((Date.parse(`${date}T00:00:00Z`) - start) / (end - start)) * 100));
const years: number[] = [];
for (let year = Number(roadmap.period.start.slice(0, 4)); year <= Number(roadmap.period.end.slice(0, 4)); year += 1) years.push(year);
---

<section class="controls" aria-label="路线图筛选">
  <label>
    <span>搜索论文、问题或机构</span>
    <input id="search" type="search" placeholder="例如：论文标题、问题或机构" />
  </label>
  <label>
    <span>发展线路</span>
    <select id="track-filter">
      <option value="all">全部线路</option>
      {roadmap.tracks.map((track) => <option value={track.id}>{track.index} · {track.name}</option>)}
    </select>
  </label>
  <button id="clear" type="button">清除筛选</button>
</section>

<div class="axis" aria-hidden="true">
  <div></div>
  <div class="axis-years">{years.map((year) => <span>{year}</span>)}</div>
</div>

<div id="roadmap-content">
  {roadmap.tracks.map((track) => {
    const papers = roadmap.papers.filter((paper) => paper.track === track.id).sort((a, b) => a.date.localeCompare(b.date));
    return (
      <section class="track-section" data-track={track.id} style={`--route:${track.color}`}>
        <header class="track-info">
          <div class="track-kicker"><span class="track-dot"></span><span>路线 {track.index}</span><strong data-track-count>{papers.length} 篇</strong></div>
          <h2>{track.name}</h2>
          <p><strong>持续问题：</strong>{track.problem}</p>
          <p class="evolution"><strong>演进：</strong>{track.evolution.map((stage) => stage.label).join(' → ')}</p>
        </header>
        <div class="timeline" aria-label={`${track.name}论文时间轴`}>
          {papers.map((paper, order) => {
            const primary = institutionMap.get(paper.institutions.primary[0]);
            const searchText = [paper.title, paper.summary, paper.problem, paper.solution, primary?.name, ...paper.institutions.primary.map((id) => institutionMap.get(id)?.name)].filter(Boolean).join(' ').toLowerCase();
            return (
              <div class="paper-node" data-paper-node data-paper-id={paper.id} data-search={searchText} data-order={order} style={`--x:${dateX(paper.date).toFixed(3)}%`}>
                <button class="paper-button" type="button" data-open-paper={paper.id} aria-label={`查看 ${paper.title} 详情`}>
                  <span class="paper-heading">
                    <InstitutionMark institution={primary} />
                    <span>{paper.title}<small>{primary?.shortName || 'Research team'}</small></span>
                  </span>
                  <time datetime={paper.date}>{paper.date.slice(0, 7)}</time>
                </button>
              </div>
            );
          })}
        </div>
      </section>
    );
  })}
</div>

<dialog id="paper-dialog">
  <article id="dialog-panel">
    <div class="dialog-band"></div>
    <button id="dialog-close" class="dialog-close" type="button" aria-label="关闭论文详情">×</button>
    <div class="dialog-content">
      <header class="dialog-header">
        <div class="dialog-meta"><time id="dialog-date"></time><span id="dialog-arxiv"></span></div>
        <h2 id="dialog-title"></h2>
        <div class="dialog-tags"><span id="dialog-track"></span><span id="dialog-confidence"></span></div>
      </header>
      <section class="dialog-institutions" aria-labelledby="dialog-institutions-title">
        <h3 id="dialog-institutions-title">研究机构</h3>
        <div id="dialog-orgs" class="dialog-orgs"></div>
      </section>
      <section class="detail-card detail-summary">
        <span class="detail-number">01</span>
        <div><h3>主要工作</h3><p id="dialog-summary"></p></div>
      </section>
      <div class="detail-columns">
        <section class="detail-card">
          <span class="detail-number">02</span>
          <div><h3>要解决的问题</h3><p id="dialog-problem"></p></div>
        </section>
        <section class="detail-card">
          <span class="detail-number">03</span>
          <div><h3>核心解决方案</h3><p id="dialog-solution"></p></div>
        </section>
      </div>
      <section class="classification-note"><span>归类说明</span><p id="dialog-rationale"></p></section>
      <nav id="dialog-links" class="dialog-links" aria-label="论文链接"></nav>
    </div>
  </article>
</dialog>

<script is:inline define:vars={{ papers: roadmap.papers, tracks: roadmap.tracks, orgs: roadmap.institutions, brandIcons: brandPaths }}>
  const paperMap = new Map(papers.map((paper) => [paper.id, paper]));
  const trackMap = new Map(tracks.map((track) => [track.id, track]));
  const institutionMap = new Map(orgs.map((institution) => [institution.id, institution]));
  const content = document.getElementById('roadmap-content');
  const search = document.getElementById('search');
  const filter = document.getElementById('track-filter');
  const clear = document.getElementById('clear');
  const dialog = document.getElementById('paper-dialog');
  const escapeHtml = (value) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);

  function renderMark(institution) {
    const brandPath = institution?.logo.kind === 'brand' ? brandIcons[institution.logo.value] : undefined;
    const content = brandPath
      ? `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${escapeHtml(brandPath)}"></path></svg>`
      : escapeHtml(institution?.logo.value || 'R');
    return `<span class="dialog-mark">${content}</span>`;
  }

  function openPaper(id) {
    const paper = paperMap.get(id);
    if (!paper) return;
    const track = trackMap.get(paper.track);
    const orgIds = [...paper.institutions.primary, ...(paper.institutions.collaborators || [])];
    const orgs = orgIds.map((orgId) => institutionMap.get(orgId)).filter(Boolean);
    const confidenceLabels = { high: '高置信度', medium: '中等置信度', low: '低置信度', editorial: '编辑判断' };
    document.getElementById('dialog-panel').style.setProperty('--route', track.color);
    document.getElementById('dialog-date').textContent = paper.date;
    document.getElementById('dialog-date').dateTime = paper.date;
    document.getElementById('dialog-arxiv').textContent = `arXiv ${paper.arxiv}`;
    document.getElementById('dialog-title').textContent = paper.title;
    document.getElementById('dialog-track').textContent = `${track.index} · ${track.name}`;
    document.getElementById('dialog-confidence').textContent = confidenceLabels[paper.classification.confidence] || paper.classification.confidence;
    document.getElementById('dialog-orgs').innerHTML = orgs.map((org, index) => {
      const role = index < paper.institutions.primary.length ? '主导机构' : '合作机构';
      return `<div class="dialog-org">${renderMark(org)}<span class="dialog-org-name"><strong>${escapeHtml(org.name)}</strong><small>${escapeHtml(org.shortName)}</small></span><span class="dialog-org-role">${role}</span></div>`;
    }).join('');
    document.getElementById('dialog-summary').textContent = paper.summary;
    document.getElementById('dialog-problem').textContent = paper.problem;
    document.getElementById('dialog-solution').textContent = paper.solution;
    document.getElementById('dialog-rationale').textContent = paper.classification.rationale;
    const labels = { paper: '阅读论文', project: '项目主页', code: '查看代码', blog: '中文详解' };
    document.getElementById('dialog-links').innerHTML = Object.entries(paper.links).map(([key, url], index) => `<a class="dialog-link${index === 0 ? ' primary' : ''}" href="${escapeHtml(url)}" target="_blank" rel="noreferrer"><span>${labels[key] || key}</span><span aria-hidden="true">↗</span></a>`).join('');
    dialog.showModal();
    history.replaceState(null, '', `#paper-${paper.id}`);
  }

  function closePaper() {
    dialog.close();
    if (location.hash.startsWith('#paper-')) history.replaceState(null, '', location.pathname + location.search);
  }

  function applyFilters() {
    const query = search.value.trim().toLowerCase();
    const selected = filter.value;
    content.querySelectorAll('[data-track]').forEach((section) => {
      const matchesTrack = selected === 'all' || section.dataset.track === selected;
      let visible = 0;
      section.querySelectorAll('[data-paper-node]').forEach((node) => {
        const matchesQuery = !query || node.dataset.search.includes(query);
        node.hidden = !(matchesTrack && matchesQuery);
        if (!node.hidden) visible += 1;
      });
      section.hidden = !matchesTrack;
      section.querySelector('[data-track-count]').textContent = `${visible} 篇`;
    });
    requestAnimationFrame(layoutTracks);
  }

  function layoutTracks() {
    if (window.innerWidth <= 680) {
      content.querySelectorAll('.timeline').forEach((timeline) => {
        timeline.style.removeProperty('height');
        timeline.style.removeProperty('--axis-y');
      });
      return;
    }
    content.querySelectorAll('.timeline').forEach((timeline) => {
      const nodes = [...timeline.querySelectorAll('[data-paper-node]:not([hidden])')].sort((a, b) => parseFloat(a.style.getPropertyValue('--x')) - parseFloat(b.style.getPropertyValue('--x')));
      if (!nodes.length) return;
      const width = timeline.clientWidth;
      const gap = 10;
      const rowGap = Math.max(62, ...nodes.map((node) => node.querySelector('.paper-button').offsetHeight + 12));
      const levels = { above: [], below: [] };
      nodes.forEach((node, order) => {
        const button = node.querySelector('.paper-button');
        const x = width * parseFloat(node.style.getPropertyValue('--x')) / 100;
        const buttonWidth = button.offsetWidth;
        const alignRight = x + buttonWidth > width - 8;
        node.dataset.alignRight = String(alignRight);
        const left = alignRight ? x - buttonWidth : x;
        const right = alignRight ? x : x + buttonWidth;
        const firstFree = (side) => {
          for (let level = 0; level < levels[side].length; level += 1) if (left > levels[side][level] + gap) return level;
          return levels[side].length;
        };
        const preferred = order % 2 === 0 ? 'above' : 'below';
        const alternate = preferred === 'above' ? 'below' : 'above';
        const preferredLevel = firstFree(preferred);
        const alternateLevel = firstFree(alternate);
        const side = preferredLevel <= alternateLevel + 1 ? preferred : alternate;
        const level = side === preferred ? preferredLevel : alternateLevel;
        levels[side][level] = right;
        node.dataset.side = side;
        node.style.setProperty('--distance', `${20 + level * rowGap}px`);
      });
      const above = Math.max(1, levels.above.length);
      const below = Math.max(1, levels.below.length);
      const axisY = 20 + above * rowGap;
      timeline.style.setProperty('--axis-y', `${axisY}px`);
      timeline.style.height = `${axisY + below * rowGap + 20}px`;
    });
  }

  content.addEventListener('click', (event) => {
    const button = event.target.closest('[data-open-paper]');
    if (button) openPaper(button.dataset.openPaper);
  });
  search.addEventListener('input', applyFilters);
  filter.addEventListener('change', applyFilters);
  clear.addEventListener('click', () => { search.value = ''; filter.value = 'all'; applyFilters(); });
  document.getElementById('dialog-close').addEventListener('click', closePaper);
  dialog.addEventListener('click', (event) => { if (event.target === dialog) closePaper(); });
  window.addEventListener('resize', () => requestAnimationFrame(layoutTracks));
  requestAnimationFrame(layoutTracks);
  const linkedPaper = location.hash.match(/^#paper-(.+)$/)?.[1];
  if (linkedPaper) openPaper(linkedPaper);
</script>

<style>
  .controls { display: grid; grid-template-columns: 1fr minmax(220px, .45fr) auto; gap: 12px; align-items: end; margin: 30px 0 42px; }
  label { display: grid; gap: 7px; color: var(--muted); font-size: 12px; }
  input, select, button { min-height: 44px; border: 1px solid var(--line); border-radius: 11px; background: var(--surface); color: var(--ink); font: inherit; }
  input, select { width: 100%; padding: 0 13px; }
  button { padding: 0 16px; cursor: pointer; }
  .axis { display: grid; grid-template-columns: 310px 1fr; align-items: end; }
  .axis-years { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; color: var(--muted); font-family: Georgia, serif; font-size: 14px; }
  .axis-years span:last-child { text-align: right; }
  .track-section { display: grid; grid-template-columns: 310px minmax(0, 1fr); border-top: 1px solid var(--line-strong); }
  .track-info { padding: 24px 30px 24px 0; }
  .track-kicker { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 12px; }
  .track-kicker strong { color: var(--route); }
  .track-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--route); }
  h2 { margin: 9px 0 0; font-family: Georgia, "Songti SC", serif; font-size: 25px; font-weight: 500; }
  .track-info p { margin: 10px 0 0; color: var(--muted); font-size: 14px; line-height: 1.65; }
  .track-info .evolution { color: var(--ink); font-size: 13px; }
  .timeline { position: relative; min-height: 190px; border-left: 1px solid var(--line); background-image: linear-gradient(to right, var(--line) 1px, transparent 1px); background-size: 25% 100%; }
  .timeline::before { content: ''; position: absolute; top: var(--axis-y, 95px); left: 0; right: 0; height: 1px; background: var(--line-strong); }
  .paper-node { position: absolute; top: var(--axis-y, 95px); left: var(--x); width: 15px; height: 15px; transform: translate(-50%, -50%); z-index: 2; }
  .paper-node::before { content: ''; position: absolute; inset: 0; width: 13px; height: 13px; border: 2px solid var(--surface); border-radius: 50%; background: var(--route); box-shadow: 0 0 0 1px color-mix(in srgb, var(--route) 60%, transparent); pointer-events: none; }
  .paper-node::after { content: ''; position: absolute; left: 7px; width: 1px; height: calc(var(--distance, 20px) - 7px); background: color-mix(in srgb, var(--route) 45%, var(--line)); pointer-events: none; }
  .paper-node[data-side='above']::after { bottom: 8px; }
  .paper-node[data-side='below']::after { top: 8px; }
  .paper-button { position: absolute; left: 7px; bottom: var(--distance, 20px); width: max-content; max-width: 190px; min-height: auto; padding: 7px 9px; background: color-mix(in srgb, var(--surface) 96%, transparent); box-shadow: 0 4px 13px rgba(31, 39, 35, .08); text-align: left; }
  .paper-node[data-side='below'] .paper-button { top: var(--distance, 20px); bottom: auto; }
  .paper-node[data-align-right='true'] .paper-button { left: auto; right: 7px; text-align: right; }
  .paper-node:hover, .paper-node:focus-within { z-index: 20; }
  .paper-button:hover { border-color: var(--route); box-shadow: 0 9px 24px rgba(31, 39, 35, .14); }
  .paper-heading { display: flex; min-width: 0; align-items: center; gap: 7px; }
  .paper-node[data-align-right='true'] .paper-heading { flex-direction: row-reverse; }
  .paper-heading > span:last-child { min-width: 0; overflow-wrap: anywhere; }
  .paper-heading small, .paper-button time { display: block; margin-top: 2px; color: var(--muted); font-size: 9px; }
  dialog { width: min(900px, calc(100% - 32px)); max-height: calc(100% - 36px); padding: 0; overflow: auto; border: 1px solid color-mix(in srgb, var(--route) 28%, var(--line)); border-radius: 24px; background: var(--surface); box-shadow: 0 32px 100px rgba(20, 27, 25, .32); color: var(--ink); }
  dialog::backdrop { background: rgba(18, 24, 22, .62); backdrop-filter: blur(9px); }
  #dialog-panel { position: relative; overflow: hidden; }
  .dialog-band { height: 6px; background: linear-gradient(90deg, var(--route), color-mix(in srgb, var(--route) 45%, var(--surface))); }
  .dialog-content { padding: 42px 44px 38px; }
  .dialog-header { padding-right: 52px; }
  .dialog-meta { display: flex; gap: 10px; align-items: center; margin-bottom: 13px; color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .dialog-meta span::before { content: ''; display: inline-block; width: 3px; height: 3px; margin: 0 10px 3px 0; border-radius: 50%; background: var(--route); }
  .dialog-header > h2 { max-width: 720px; margin: 0; font-size: clamp(36px, 5vw, 54px); line-height: 1.02; letter-spacing: -.035em; overflow-wrap: anywhere; }
  .dialog-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 17px; }
  .dialog-tags span { padding: 6px 10px; border: 1px solid color-mix(in srgb, var(--route) 20%, var(--line)); border-radius: 999px; background: color-mix(in srgb, var(--route) 8%, var(--surface)); color: color-mix(in srgb, var(--route) 82%, var(--ink)); font-size: 11px; font-weight: 800; letter-spacing: .02em; }
  .dialog-close { position: absolute; z-index: 2; top: 21px; right: 22px; display: grid; place-items: center; width: 42px; min-height: 42px; padding: 0 0 2px; border-color: color-mix(in srgb, var(--route) 16%, var(--line)); border-radius: 50%; background: color-mix(in srgb, var(--surface) 92%, transparent); color: var(--muted); font-size: 25px; line-height: 1; transition: transform .18s ease, border-color .18s ease, color .18s ease; }
  .dialog-close:hover { transform: rotate(6deg); border-color: var(--route); color: var(--ink); }
  .dialog-institutions { margin-top: 30px; }
  .dialog-institutions > h3 { margin: 0 0 10px; color: var(--muted); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
  .dialog-orgs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  :global(.dialog-org) { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: 11px; align-items: center; min-height: 64px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 14px; background: color-mix(in srgb, var(--bg) 46%, var(--surface)); }
  :global(.dialog-mark) { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid color-mix(in srgb, var(--route) 25%, var(--line)); border-radius: 11px; background: var(--surface); color: color-mix(in srgb, var(--route) 80%, var(--ink)); font-size: 9px; font-weight: 800; }
  :global(.dialog-mark svg) { width: 24px; height: 24px; fill: currentColor; }
  :global(.dialog-org-name) { min-width: 0; }
  :global(.dialog-org-name strong), :global(.dialog-org-name small) { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.dialog-org-name strong) { font-size: 13px; }
  :global(.dialog-org-name small) { margin-top: 3px; color: var(--muted); font-size: 10px; }
  :global(.dialog-org-role) { align-self: start; padding: 4px 7px; border-radius: 999px; background: color-mix(in srgb, var(--route) 10%, var(--surface)); color: color-mix(in srgb, var(--route) 72%, var(--ink)); font-size: 9px; font-weight: 800; white-space: nowrap; }
  .detail-card { display: grid; grid-template-columns: 30px 1fr; gap: 14px; padding: 22px; border: 1px solid var(--line); border-radius: 16px; background: color-mix(in srgb, var(--surface) 86%, var(--bg)); }
  .detail-summary { margin-top: 26px; border-color: color-mix(in srgb, var(--route) 34%, var(--line)); background: linear-gradient(135deg, color-mix(in srgb, var(--route) 8%, var(--surface)), var(--surface) 58%); }
  .detail-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 12px; }
  .detail-number { color: var(--route); font-family: Georgia, serif; font-size: 13px; font-weight: 700; }
  .detail-card h3 { margin: 0 0 8px; color: var(--muted); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }
  .detail-card p { margin: 0; font-size: 15px; line-height: 1.75; }
  .detail-summary p { font-size: 17px; line-height: 1.7; }
  .classification-note { display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: start; margin-top: 12px; padding: 16px 18px; border-left: 3px solid var(--route); border-radius: 0 12px 12px 0; background: color-mix(in srgb, var(--route) 6%, var(--surface)); }
  .classification-note > span { color: var(--route); font-size: 11px; font-weight: 800; letter-spacing: .08em; white-space: nowrap; }
  .classification-note p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.65; }
  .dialog-links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; padding-top: 22px; border-top: 1px solid var(--line); }
  :global(.dialog-link) { display: inline-flex; gap: 22px; justify-content: space-between; align-items: center; min-width: 138px; padding: 11px 14px; border: 1px solid color-mix(in srgb, var(--route) 25%, var(--line)); border-radius: 11px; color: var(--ink); font-size: 13px; font-weight: 750; text-decoration: none; transition: transform .18s ease, border-color .18s ease, background .18s ease; }
  :global(.dialog-link:hover) { transform: translateY(-2px); border-color: var(--route); background: color-mix(in srgb, var(--route) 7%, var(--surface)); }
  :global(.dialog-link.primary) { border-color: var(--route); background: var(--route); color: var(--surface); }
  @media (max-width: 980px) {
    .axis { display: none; }
    .track-section { grid-template-columns: 1fr; padding: 24px 0 28px; }
    .track-info { padding: 0 0 20px; }
    .timeline { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  }
  @media (max-width: 680px) {
    .controls { grid-template-columns: 1fr; }
    .timeline { min-height: auto; padding: 12px; background-image: none; }
    .timeline::before, .paper-node::before, .paper-node::after { display: none; }
    .paper-node { position: static; display: block; width: auto; height: auto; margin: 7px 0; transform: none; }
    .paper-button, .paper-node[data-side='below'] .paper-button { position: static; display: flex; justify-content: space-between; gap: 12px; width: 100%; max-width: none; padding: 11px 12px; }
    .paper-node[data-align-right='true'] .paper-heading { flex-direction: row; }
    dialog { width: calc(100% - 16px); max-height: calc(100% - 16px); border-radius: 18px; }
    .dialog-content { padding: 30px 18px 22px; }
    .dialog-header { padding-right: 40px; }
    .dialog-header > h2 { font-size: clamp(32px, 12vw, 44px); }
    .dialog-close { top: 16px; right: 14px; width: 38px; min-height: 38px; }
    .dialog-orgs, .detail-columns { grid-template-columns: 1fr; }
    .detail-card { padding: 18px 16px; }
    .detail-summary p { font-size: 16px; }
    .classification-note { grid-template-columns: 1fr; gap: 6px; }
    :global(.dialog-link) { flex: 1 1 140px; }
  }
</style>
